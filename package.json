{
  "name": "tokyorailmap",
  "version": "1.0.5",
  "description": "东京都市圈铁路线网与班次信息可视化。",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "buildall": "electron-builder --win --mac -p never",
    "bp": "npm version patch && npm run buildall",
    "bmm": "npm version minor && npm run buildall",
    "bm": "npm version major && npm run buildall",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blysh-Ley/TokyoRailMap.git"
  },
  "author": "Blysh",
  "license": "MIT",
  "build": {
    "appId": "com.blysh.tokyorailmap",
    "productName": "东京铁路图",
    "artifactName": "TokyoRailMap-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "releaseInfo": {
      "releaseNotesFile": "CHANGELOG.md"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Blysh-Ley",
        "repo": "TokyoRailMap"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "东京铁路图",
      "installerIcon": "icons/icon.ico",
      "uninstallerIcon": "icons/icon.ico",
      "uninstallDisplayName": "卸载东京铁路图"
    },
    "mac": {
      "icon": "icons/icon.icns",
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "dmg": {
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^41.2.1",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}
