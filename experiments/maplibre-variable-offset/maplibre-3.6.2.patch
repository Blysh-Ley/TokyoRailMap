+import Point from '@mapbox/point-geometry';
+
+export type LineOffsetProfile = Array<[number, number]>;
+export type LineOffsetClip = {start: number; end: number};
+
+// 曲线值是现有 line-offset 的倍率；不改变原始坐标或缩放表达式。
+export function readLineOffsetProfile(properties: {[key: string]: any}): LineOffsetProfile | null {
+    const raw = properties?.line_offset_profile;
+    if (raw === undefined) return null;
+    const profile = typeof raw === 'string' ? JSON.parse(raw) : raw;
+    if (!Array.isArray(profile) || profile.length === 0) throw new Error('line_offset_profile 必须是非空的 [沿线进度, 偏移倍率] 数组');
+    let previous = -1;
+    for (const stop of profile) {
+        if (!Array.isArray(stop) || stop.length !== 2 || !Number.isFinite(stop[0]) || !Number.isFinite(stop[1]) || stop[0] < 0 || stop[0] > 1 || stop[0] <= previous) {
+            throw new Error('line_offset_profile 的进度必须在 0 到 1 之间严格递增，偏移倍率必须为有限数值');
+        }
+        previous = stop[0];
+    }
+    const additional = Number(properties?.line_offset_units) || 0;
+    return additional ? profile.map(([progress, factor]) => [progress, factor + additional]) : profile;
+}
+
+export function lineOffsetFactor(profile: LineOffsetProfile, progress: number): number {
+    if (progress <= profile[0][0]) return profile[0][1];
+    for (let i = 1; i < profile.length; i++) {
+        const [end, to] = profile[i];
+        if (progress > end) continue;
+        const [start, from] = profile[i - 1];
+        const t = (progress - start) / (end - start);
+        const eased = t * t * (3 - 2 * t);
+        return from + (to - from) * eased;
+    }
+    return profile[profile.length - 1][1];
+}
+
+export function lineOffsetClip(properties: {[key: string]: any}): LineOffsetClip {
+    return {
+        start: properties?.mapbox_clip_start ?? 0,
+        end: properties?.mapbox_clip_end ?? 1
+    };
+}
+
+export function lineVertexProgress(vertices: Array<Point>, clip: LineOffsetClip): Array<number> {
+    const lengths = [0];
+    for (let i = 1; i < vertices.length; i++) lengths.push(lengths[i - 1] + vertices[i].dist(vertices[i - 1]));
+    const total = lengths[lengths.length - 1];
+    return lengths.map(length => total ? clip.start + (clip.end - clip.start) * length / total : clip.start);
+}
+
+// 在 Worker 完成瓦片切割之后补齐过渡采样；同一曲线使用全线进度，不在瓦片边界重启。
+export function sampleLineOffsetGeometry(vertices: Array<Point>, profile: LineOffsetProfile, clip: LineOffsetClip): Array<Point> {
+    if (vertices.length < 2 || clip.end <= clip.start) return vertices;
+    const progress = lineVertexProgress(vertices, clip);
+    const samples: Array<number> = [];
+    const values = profile.map(stop => stop[1]);
+    const span = Math.max(...values) - Math.min(...values);
+    for (let i = 1; i < profile.length; i++) {
+        const [start, from] = profile[i - 1];
+        const [end, to] = profile[i];
+        // 子段曲线已补过采样，按幅度分配细分，避免再次把每个采样区间扩展 32 倍。
+        const steps = from === to ? 1 : Math.max(1, Math.ceil(Math.abs(to - from) * 32 / span));
+        for (let j = 0; j <= steps; j++) {
+            const position = start + (end - start) * j / steps;
+            if (position > clip.start && position < clip.end) samples.push(position);
+        }
+    }
+    samples.sort((a, b) => a - b);
+    const result: Array<Point> = [vertices[0]];
+    let index = 0;
+    for (let i = 1; i < vertices.length; i++) {
+        const start = progress[i - 1];
+        const end = progress[i];
+        while (index < samples.length && samples[index] <= start) index++;
+        while (index < samples.length && samples[index] < end) {
+            const fraction = (samples[index++] - start) / (end - start);
+            const point = vertices[i - 1].add(vertices[i].sub(vertices[i - 1]).mult(fraction));
+            if (!point.equals(result[result.length - 1])) result.push(point);
+        }
+        if (!vertices[i].equals(result[result.length - 1])) result.push(vertices[i]);
+    }
+    return result;
+}
+
+// 查询复用与顶点生成相同的采样和缓动，让点击位置随显示路径移动。
+export function offsetProfileGeometry(rings: Array<Array<Point>>, profile: LineOffsetProfile, clip: LineOffsetClip, offset: number): Array<Array<Point>> {
+    return rings.map(ring => {
+        const vertices = sampleLineOffsetGeometry(ring, profile, clip);
+        const progress = lineVertexProgress(vertices, clip);
+        return vertices.map((point, index) => {
+            const amount = offset * lineOffsetFactor(profile, progress[index]);
+            if (amount === 0) return point;
+            const previous = vertices[index - 1];
+            const next = vertices[index + 1];
+            const before = previous ? point.sub(previous)._unit()._perp() : new Point(0, 0);
+            const after = next ? next.sub(point)._unit()._perp() : new Point(0, 0);
+            const normal = before._add(after)._unit();
+            const cosine = normal.x * after.x + normal.y * after.y;
+            if (cosine !== 0) normal._mult(1 / cosine);
+            return normal._mult(amount)._add(point);
+        });
+    });
+}
