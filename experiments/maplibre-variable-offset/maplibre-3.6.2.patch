+// 在原生线路着色器的同一个偏移位置应用倍率，沿用端帽、连接和抗锯齿处理。
+export function variableOffsetVertexSource(source: string): string {
+    return source.replace('attribute vec4 a_data;', 'attribute vec4 a_data;attribute float a_offset_factor;')
+        .replace(/offset\s*=\s*-1\.0\s*\*\s*offset;/, 'offset=-1.0*offset*a_offset_factor;');
+}
