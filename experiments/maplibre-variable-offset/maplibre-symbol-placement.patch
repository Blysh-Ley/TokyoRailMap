@@ -0,0 +1,35 @@
+import type {FeatureKey} from './collision_index';
+
+export type CollisionGroup = {ID: number; predicate?: (key: FeatureKey) => boolean};
+
+// 显式碰撞组独立于默认共享组；普通图层继续保持原来的跨源策略。
+export class CollisionGroups {
+    collisionGroups: {[key: string]: CollisionGroup} = {};
+    maxGroupID = 0;
+    crossSourceCollisions: boolean;
+
+    constructor(crossSourceCollisions: boolean) {
+        this.crossSourceCollisions = crossSourceCollisions;
+    }
+
+    get(sourceID: string, name?: string): CollisionGroup {
+        if (!name && this.crossSourceCollisions) return {ID: 0, predicate: key => key.collisionGroupID === 0};
+        const key = name ? `group:${name}` : `source:${sourceID}`;
+        if (!this.collisionGroups[key]) {
+            const ID = ++this.maxGroupID;
+            this.collisionGroups[key] = {ID, predicate: feature => feature.collisionGroupID === ID};
+        }
+        return this.collisionGroups[key];
+    }
+}
+
+// 每轮 placement 跨瓦片共享，只有真正可见的成功候选才终止该组的尝试。
+export class SymbolCandidateGroups {
+    placed = new Set<string>();
+    has(key: string): boolean { return this.placed.has(key); }
+    accept(key: string, visible: boolean): boolean {
+        if (!visible || this.placed.has(key)) return false;
+        this.placed.add(key);
+        return true;
+    }
+}
