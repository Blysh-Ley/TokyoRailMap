# TokyoRailMap source and build boundary
# Keep the Web, Electron, Capacitor native projects, release scripts, and smoke
# tests trackable; ignore only dependencies, generated outputs, and local files.

# OS/editor metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Local environment, caches, and logs
.env
.env.*
!.env.example
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.codex/
.codex-runtime/
.npm-cache/
.venv/
__pycache__/
**/__pycache__/
*.py[cod]

# Dependency installs and generated web/native output
node_modules/
dist/
dist
www/
remotedata/
legacy/
backups/
.github/
*.dmg
*.exe
*.blockmap
*.apk
*.aab
*.ap_
*.jks
*.keystore

# Alternate package-manager metadata (this project uses package-lock.json)
npm-shrinkwrap.json
pnpm-lock.yaml
yarn.lock
electron-builder.*
electron.vite.config.*

# Audit tools and local reports
tools/
docs/*
!docs/android-build.md
Refactor-Panel.md
AGENTS.md
line-icon-preview.html
src/debug/
!src/debug/
src/debug/*
!src/debug/stationOffsetPerformanceProbe.js

# Local/generated basemap packages and source extracts
tiles/*
*.pmtiles
*.mbtiles
*.osm.pbf

# Capacitor-generated web bundles
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
ios/App/App/public/
ios/App/App/capacitor.config.json
ios/App/App/config.xml
ios/capacitor-cordova-ios-plugins/

# Android local/build artifacts
android/.gradle/
android/build/
android/**/build/
android/app/build/
android/app/release/
android/local.properties
android/*.iml
android/app/*.iml

# iOS local/build artifacts
ios/App/build/
ios/App/Pods/
ios/App/DerivedData/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
*.xcuserstate

# Timestamp-suffixed conflict copies left by local file recovery
**/* [0-9][0-9]-[0-9][0-9]-[0-9][0-9]-[0-9][0-9][0-9].*

# Temporary local review server; its GBData working set is not part of this repo
scripts/gbdata-review-server.mjs

# Readme/demo-only media and local data scratch files
assets/readme-images/
promo/
data/**/*.bak
data/tmp/
videos/
renders/
